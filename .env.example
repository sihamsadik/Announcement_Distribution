# Telegram Bot API Configuration (Required)
# Obtain this token from @BotFather on Telegram (format: <bot_id>:<token>)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# PostgreSQL Database Connection URL (Required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/announcement_db?schema=public"

# Authorized Administrator Telegram User IDs (Optional, comma-separated integers)
# Example: ADMIN_USER_IDS="123456789,987654321"
ADMIN_USER_IDS=""

# Delivery Retry Configuration (Optional defaults shown)
MAX_RETRY_COUNT=3
INITIAL_RETRY_DELAY_SECONDS=5
MAX_RETRY_DELAY_SECONDS=300
RETRY_POLL_INTERVAL_MS=10000

# Health Check HTTP Server Configuration (Optional)
HEALTH_PORT=3000

# Structured Logging Configuration (Optional)
# LOG_LEVEL: "debug", "info", "warn", or "error"
LOG_LEVEL="info"
# LOG_FORMAT: "text" (human-readable for dev) or "json" (production collectors)
LOG_FORMAT="text"

# Application Environment
NODE_ENV="development"
