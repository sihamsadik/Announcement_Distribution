# Telegram Bot API Configuration
# Obtain this token from BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/announcement_db?schema=public"

# Authorized Administrator Telegram User IDs (comma-separated integers)
# Example: ADMIN_USER_IDS="123456789,987654321"
ADMIN_USER_IDS=
