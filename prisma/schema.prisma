generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ForwardingStatus {
  PENDING
  RETRYING
  SUCCESS
  FAILED
}

enum DeadlineStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReminderType {
  REMINDER_24_HOUR
  ADDITIONAL
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model SourceGroup {
  id        String   @id @default(uuid())
  chatId    BigInt
  topicId   BigInt
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  destinationGroups DestinationGroup[]
  deadlines          Deadline[]

  @@unique([chatId, topicId])
  @@index([chatId])
  @@index([isActive])
}

model DestinationGroup {
  id            String      @id @default(uuid())
  sourceGroupId String
  chatId        BigInt
  groupName     String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  sourceGroup           SourceGroup                @relation(fields: [sourceGroupId], references: [id], onDelete: Cascade)
  forwardingLogs        ForwardingLog[]
  deadlineAnnouncements DeadlineAnnouncement[]
  deadlineReminders     DeadlineReminderDelivery[]

  @@unique([sourceGroupId, chatId])
  @@index([chatId])
  @@index([sourceGroupId, isActive])
}

model ForwardingLog {
  id                 String           @id @default(uuid())
  sourceChatId       BigInt
  sourceMessageId    Int
  destinationGroupId String
  status             ForwardingStatus
  errorMessage       String?
  retryCount         Int              @default(0)
  lastAttemptAt      DateTime         @default(now())
  nextRetryAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt @default(now())

  destinationGroup DestinationGroup @relation(fields: [destinationGroupId], references: [id], onDelete: Cascade)

  @@unique([sourceChatId, sourceMessageId, destinationGroupId])
  @@index([destinationGroupId])
  @@index([status])
  @@index([createdAt])
  @@index([sourceChatId, sourceMessageId])
  @@index([status, nextRetryAt])
}

model Deadline {
  id                   String                     @id @default(uuid())
  sourceGroupId        String
  title                String
  description          String
  dueAt                DateTime
  timezone             String                     @default("Africa/Addis_Ababa")
  status               DeadlineStatus             @default(ACTIVE)
  additionalReminderAt DateTime?
  createdBy            BigInt
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt @default(now())

  sourceGroup          SourceGroup                @relation(fields: [sourceGroupId], references: [id], onDelete: Restrict)
  announcements        DeadlineAnnouncement[]
  reminderDeliveries   DeadlineReminderDelivery[]

  @@index([sourceGroupId])
  @@index([status, dueAt])
}

model DeadlineAnnouncement {
  id                 String           @id @default(uuid())
  deadlineId         String
  destinationGroupId String
  telegramMessageId  Int?
  isPinned           Boolean          @default(false)
  pinErrorMessage    String?
  status             DeliveryStatus   @default(PENDING)
  errorMessage       String?
  sentAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt @default(now())

  deadline           Deadline         @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  destinationGroup   DestinationGroup @relation(fields: [destinationGroupId], references: [id], onDelete: Restrict)

  @@unique([deadlineId, destinationGroupId])
  @@index([deadlineId])
  @@index([destinationGroupId])
}

model DeadlineReminderDelivery {
  id                 String           @id @default(uuid())
  deadlineId         String
  destinationGroupId String
  reminderType       ReminderType
  status             DeliveryStatus   @default(PENDING)
  telegramMessageId  Int?
  errorMessage       String?
  scheduledFor       DateTime
  sentAt             DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt @default(now())

  deadline           Deadline         @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  destinationGroup   DestinationGroup @relation(fields: [destinationGroupId], references: [id], onDelete: Restrict)

  @@unique([deadlineId, destinationGroupId, reminderType])
  @@index([deadlineId])
  @@index([destinationGroupId])
  @@index([status, scheduledFor])
}
